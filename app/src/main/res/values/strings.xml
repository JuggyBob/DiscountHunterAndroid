    <!-- Background sale and free-game announcements. -->
    <string name="settings_alerts_title">Deal alerts</string>
    <string name="settings_alerts_summary">Tell me when a saved game goes on sale, and when a game becomes free to keep.</string>
    <string name="settings_alerts_note">Checked about once an hour in the background, including when the app is closed. Only changes are announced: a game that is still on sale tomorrow is not announced again. A game that is already on sale when you turn this on is not announced either — the check starts from now.</string>
    <string name="settings_alerts_permission_needed">Notifications are blocked for Discount Hunter, so alerts cannot be shown. Allow them in the system settings.</string>
