    <string name="intro_start">Start hunting</string>
    <string name="intro_1_title">Every deal, one feed</string>
    <string name="intro_1_body">Steam, GOG and Epic\'s free-games feed are merged into a single list, sorted by the deepest discount. Free games float to the top.</string>
    <string name="intro_1_caption">Three stores, one list</string>
    <string name="intro_2_title">Search at once</string>
    <string name="intro_2_body">One query runs against every store. Results show the cheapest price available and which stores matched, so you never open three tabs to compare.</string>
    <string name="intro_2_caption">Cheapest price wins</string>
    <string name="intro_3_title">See it before you buy</string>
    <string name="intro_3_body">Screenshots and trailers belong to the game you tapped — never to some other title that merely looks similar. Trailers play right on the page.</string>
    <string name="intro_3_caption">Media that always matches</string>
    <string name="intro_4_title">Wishlist that watches</string>
    <string name="intro_4_body">Star anything you are saving up for. When it drops, the wishlist tells you the moment it goes on sale, and from which store.</string>
    <string name="intro_4_caption">Told the moment it drops</string>
    <string name="intro_5_title">Price history</string>
    <string name="intro_5_body">Every price this device has recorded for a game, charted over time — with a link to SteamDB, EGData, GOG Database and the rest for the full history.</string>
    <string name="intro_5_caption">Know if it is a good deal</string>    <string name="settings_diagnostics">Diagnostics</string>
    <string name="settings_export_logs_title">Export logs</string>
    <string name="settings_export_logs_body">Saves the last few hundred app messages plus your device and memory info to a text file you can share, so a bug report can include what happened before it went wrong. No personal data is recorded.</string>
    <string name="settings_export_logs">Export logs</string>
    <string name="settings_currency_note">Sets the region prices are requested in. Steam and Epic re-quote in that currency; GOG does not, so its prices keep their own currency and are labelled with it.</string>
    <string name="settings_delete_data">Delete all app data</string>
    <string name="settings_delete_data_title">Delete everything</string>
    <string name="settings_delete_data_body">Wishlist, recent searches, cached pages and saved price history. Your settings go too, and the intro pages come back on the next launch.</string>
    <string name="settings_delete_data_confirm_title">Delete all app data?</string>
    <string name="settings_delete_data_confirm_body">This permanently removes your wishlist, recent searches, cached pages, price history and every setting on this device. It cannot be undone.</string>
    <string name="settings_delete_data_confirm_yes">Delete everything</string>
