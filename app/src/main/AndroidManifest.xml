<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        The background check needs to be able to tell the user about a sale, and to keep doing so
        after a reboot. Without the boot permission the schedule is silently lost on restart,
        which is one of the ways "the notifications stopped working" happens.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Exact alarms make the check punctual rather than batched. The user can refuse this
        permission, so the scheduler asks first and falls back to an inexact alarm, which still
        works inside Doze.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".DiscountHunterApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DiscountHunter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DiscountHunter">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links straight to a game's page. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="store.steampowered.com" android:pathPrefix="/app/" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.gog.com" android:pathPrefix="/en/game/" />
                <data android:scheme="https" android:host="gog.com" android:pathPrefix="/en/game/" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="store.epicgames.com" android:pathPrefix="/p/" />
            </intent-filter>

            <!-- Custom scheme so other apps (and adb) can open a game by its stable id. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="discounthunter" />
            </intent-filter>
        </activity>
    <!--
            Exists so Settings can hand the diagnostics report to another app. A raw `file://` URI
            throws FileUriExposedException on any modern Android, which is exactly the kind of
            "works on my device" failure the export exists to catch.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_paths" />
        </provider>
        <!--
            The punctual half of the background check. WorkManager's periodic worker is the
            guaranteed half; this alarm is the one that is actually on time. Both queue the same
            idempotent worker, so whichever fires first does the work.
        -->
        <receiver
            android:name=".alerts.DealAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.discounthunter.android.action.CHECK_DEALS" />
            </intent-filter>
        </receiver>

        <!--
            Alarms do not survive a reboot, so the schedule is restored here. The user's setting
            is the source of truth: a reboot must not switch monitoring back on if it was off.
        -->
        <receiver
            android:name=".alerts.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
