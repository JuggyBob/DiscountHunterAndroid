# ---- Gradle / Android build output -------------------------------------------
build/
.gradle/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
output-metadata.json
baselineProfiles/

# ...except the deliberately committed release APKs under apk/, which exist so
# people can install the app without a build environment. This negation must come
# after `*.apk` above, because in .gitignore the last matching rule wins.
!apk/**/*.apk

# ---- Local machine configuration ---------------------------------------------
local.properties
*.keystore
*.jks
keystore.properties
signing.properties

