.idea/
*.iml
*.ipr
*.iws
.fleet/
.navigation/
captures/
*.hprof

# Android Studio / IntelliJ
out/
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf/

# ---- Gradle -----------------------------------------------------------------
!gradle/wrapper/gradle-wrapper.jar
.gradletasknamecache/
.kotlin/

# ---- OS noise ---------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.directory

# ---- Logs and diagnostics ---------------------------------------------------
*.log
logs/
crashlytics-build.log

# ---- Secrets ----------------------------------------------------------------
secrets.properties
.env
.env.*
*.p12
*.pem
